digraph CodebaseArchitecture {
    // Graph Styling Architecture
    rankdir=LR;
    splines=true;
    overlap=false;
    nodesep=0.4;
    ranksep=0.7;
    node [shape=box, style="rounded,filled", fillcolor="#f8f9fa", color="#6c757d", fontname="Helvetica", fontsize=11, margin=0.15];
    edge [color="#adb5bd", arrowsize=0.6, fontname="Helvetica", fontsize=9];

    // ==========================================
    // 1. MODULE CLUSTERS & WORKSPACE DIRECTORIES
    // ==========================================
    node_config_py [label="📄 config.py", fillcolor="#fff3cd", color="#ffc107"];
    node_generate_graph_py [label="📄 generate_graph.py", fillcolor="#fff3cd", color="#ffc107"];
    node_test_setup_py [label="📄 test_setup.py", fillcolor="#fff3cd", color="#ffc107"];
    subgraph cluster_0 {
        label="📁 eval";
        style="filled,dashed";
        color="#e9ecef";
        fillcolor="#f1f3f5";
        node_eval_ragas_eval_py [label="📄 ragas_eval.py"];
        node_eval_run_eval_py [label="📄 run_eval.py"];
    }
    subgraph cluster_1 {
        label="📁 scripts";
        style="filled,dashed";
        color="#e9ecef";
        fillcolor="#f1f3f5";
        node_scripts_advanced_query_py [label="📄 advanced_query.py"];
        node_scripts_agentic_query_py [label="📄 agentic_query.py"];
        node_scripts_ingest_py [label="📄 ingest.py"];
        node_scripts_inspect_embeddings_py [label="📄 inspect_embeddings.py"];
        node_scripts_query_py [label="📄 query.py"];
    }
    subgraph cluster_2 {
        label="📁 src/agent";
        style="filled,dashed";
        color="#e9ecef";
        fillcolor="#f1f3f5";
        node_src_agent_langchain_agent_py [label="📄 langchain_agent.py"];
        node_src_agent_prompts_py [label="📄 prompts.py"];
        node_src_agent_react_agent_py [label="📄 react_agent.py"];
        node_src_agent_tools_py [label="📄 tools.py"];
        node_src_agent___init___py [label="📄 __init__.py"];
    }
    subgraph cluster_3 {
        label="📁 src/embedding";
        style="filled,dashed";
        color="#e9ecef";
        fillcolor="#f1f3f5";
        node_src_embedding_embedder_py [label="📄 embedder.py"];
        node_src_embedding___init___py [label="📄 __init__.py"];
    }
    subgraph cluster_4 {
        label="📁 src/ingestion";
        style="filled,dashed";
        color="#e9ecef";
        fillcolor="#f1f3f5";
        node_src_ingestion_chunker_py [label="📄 chunker.py"];
        node_src_ingestion_loader_py [label="📄 loader.py"];
        node_src_ingestion___init___py [label="📄 __init__.py"];
    }
    subgraph cluster_5 {
        label="📁 src/llm";
        style="filled,dashed";
        color="#e9ecef";
        fillcolor="#f1f3f5";
        node_src_llm_client_py [label="📄 client.py"];
        node_src_llm___init___py [label="📄 __init__.py"];
    }
    subgraph cluster_6 {
        label="📁 src/pipeline";
        style="filled,dashed";
        color="#e9ecef";
        fillcolor="#f1f3f5";
        node_src_pipeline_advanced_rag_py [label="📄 advanced_rag.py"];
        node_src_pipeline_query_rewriter_py [label="📄 query_rewriter.py"];
        node_src_pipeline_rag_py [label="📄 rag.py"];
        node_src_pipeline___init___py [label="📄 __init__.py"];
    }
    subgraph cluster_7 {
        label="📁 src/retrieval";
        style="filled,dashed";
        color="#e9ecef";
        fillcolor="#f1f3f5";
        node_src_retrieval_bm25_retriever_py [label="📄 bm25_retriever.py"];
        node_src_retrieval_fusion_py [label="📄 fusion.py"];
        node_src_retrieval_reranker_py [label="📄 reranker.py"];
        node_src_retrieval_retriever_py [label="📄 retriever.py"];
        node_src_retrieval___init___py [label="📄 __init__.py"];
    }
    subgraph cluster_8 {
        label="📁 src/vectorstore";
        style="filled,dashed";
        color="#e9ecef";
        fillcolor="#f1f3f5";
        node_src_vectorstore_store_py [label="📄 store.py"];
        node_src_vectorstore___init___py [label="📄 __init__.py"];
    }
    subgraph cluster_9 {
        label="📁 tests";
        style="filled,dashed";
        color="#e9ecef";
        fillcolor="#f1f3f5";
        node_tests_test_chunker_py [label="📄 test_chunker.py"];
    }
    // ==========================================
    // 2. DEPENDENCY MAP LINKS
    // ==========================================
    node_eval_ragas_eval_py -> node_config_py [label="imports"];
    node_eval_run_eval_py -> node_src_pipeline_advanced_rag_py [label="imports"];
    node_scripts_advanced_query_py -> node_src_pipeline_advanced_rag_py [label="imports"];
    node_scripts_agentic_query_py -> node_src_agent_react_agent_py [label="imports"];
    node_scripts_agentic_query_py -> node_src_agent_langchain_agent_py [label="imports"];
    node_scripts_ingest_py -> node_config_py [label="imports"];
    node_scripts_ingest_py -> node_src_ingestion_loader_py [label="imports"];
    node_scripts_ingest_py -> node_src_ingestion_chunker_py [label="imports"];
    node_scripts_ingest_py -> node_src_vectorstore_store_py [label="imports"];
    node_scripts_inspect_embeddings_py -> node_config_py [label="imports"];
    node_scripts_query_py -> node_src_retrieval_retriever_py [label="imports"];
    node_scripts_query_py -> node_src_pipeline_rag_py [label="imports"];
    node_src_agent_langchain_agent_py -> node_src_agent_tools_py [label="imports"];
    node_src_agent_langchain_agent_py -> node_config_py [label="imports"];
    node_src_agent_react_agent_py -> node_src_agent_prompts_py [label="imports"];
    node_src_agent_react_agent_py -> node_src_agent_tools_py [label="imports"];
    node_src_agent_react_agent_py -> node_src_llm_client_py [label="imports"];
    node_src_agent_tools_py -> node_config_py [label="imports"];
    node_src_agent_tools_py -> node_src_pipeline_advanced_rag_py [label="imports"];
    node_src_embedding_embedder_py -> node_config_py [label="imports"];
    node_src_ingestion_chunker_py -> node_config_py [label="imports"];
    node_src_llm_client_py -> node_config_py [label="imports"];
    node_src_pipeline_advanced_rag_py -> node_src_retrieval_retriever_py [label="imports"];
    node_src_pipeline_advanced_rag_py -> node_src_retrieval_bm25_retriever_py [label="imports"];
    node_src_pipeline_advanced_rag_py -> node_src_retrieval_fusion_py [label="imports"];
    node_src_pipeline_advanced_rag_py -> node_src_retrieval_reranker_py [label="imports"];
    node_src_pipeline_advanced_rag_py -> node_src_pipeline_query_rewriter_py [label="imports"];
    node_src_pipeline_advanced_rag_py -> node_src_llm_client_py [label="imports"];
    node_src_pipeline_advanced_rag_py -> node_config_py [label="imports"];
    node_src_pipeline_query_rewriter_py -> node_src_llm_client_py [label="imports"];
    node_src_pipeline_query_rewriter_py -> node_config_py [label="imports"];
    node_src_pipeline_rag_py -> node_src_retrieval_retriever_py [label="imports"];
    node_src_pipeline_rag_py -> node_src_llm_client_py [label="imports"];
    node_src_pipeline_rag_py -> node_config_py [label="imports"];
    node_src_retrieval_bm25_retriever_py -> node_config_py [label="imports"];
    node_src_retrieval_fusion_py -> node_config_py [label="imports"];
    node_src_retrieval_reranker_py -> node_config_py [label="imports"];
    node_src_retrieval_retriever_py -> node_src_vectorstore_store_py [label="imports"];
    node_src_retrieval_retriever_py -> node_config_py [label="imports"];
    node_src_vectorstore_store_py -> node_config_py [label="imports"];
    node_src_vectorstore_store_py -> node_src_embedding_embedder_py [label="imports"];
}