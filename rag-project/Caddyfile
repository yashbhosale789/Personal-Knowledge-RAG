{$DOMAIN} {
	@blocked path /metrics* /ingest*
	handle @blocked {
		respond 404
	}
	# FastAPI spools a multipart body to disk before the key or size check runs: stop big ones here.
	# Just above config.MAX_UPLOAD_BYTES (10 MiB) plus multipart overhead.
	request_body /documents {
		max_size 11MiB
	}
	# FastAPI also reads JSON bodies before the key check (review R1, 15.4). The largest valid
	# /query is ~25K chars (query + 5 history turns), under 150 KB even fully \u-escaped.
	@json path /query /query/* /feedback
	request_body @json {
		max_size 256KB
	}
	handle {
		reverse_proxy app:8000
	}
}