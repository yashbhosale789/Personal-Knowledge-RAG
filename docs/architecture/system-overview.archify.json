  "cards": [
    { "dot": "cyan", "title": "Query path", "items": [
      "A semantic cache hit in Redis (cosine ≥ 0.87) returns without running the pipeline",
      "Miss: rewrite → dense + BM25 → RRF → cross-encoder rerank → sufficiency gate",
      "Generation streams via Groq, falling back to OpenRouter then Gemini; a second model verifies citations"
    ] },
    { "dot": "emerald", "title": "Write path", "items": [
      "Every write goes through ingest_file(), one at a time (busy → 409)",
      "Injection scan before anything is deleted or stored",
      "index_changed() clears the semantic cache and drops BM25; the next query rebuilds it from Chroma"
    ] },
    { "dot": "rose", "title": "Delivery and exposure", "items": [
      "Merge to main builds the image to GHCR; SSM runs deploy.sh on EC2, no SSH port",
      "Unhealthy deploy rolls back to the previous image",
      "Caddy 404s /metrics and /ingest; Grafana binds to 127.0.0.1 only"
    ] }
  ]
